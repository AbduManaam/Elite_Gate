				},
				{
					"name": "POST /reload (Gateway Direct)",
					"request": {
						"url": "{{gateway_url}}/reload",
						"method": "POST",
						"auth": { "type": "noauth" },
						"description": "Directly reload a single gateway node's cache (internal/admin use)."
					}
				}
			]
		},
