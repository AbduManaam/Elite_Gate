{
	"info": {
		"name": "CoreGuard Gateway API",
		"description": "Complete API collection for CoreGuard Gateway – Admin API + Gateway endpoints.\n\n## Authentication\nMost `/admin/v1/*` endpoints require a JWT token.\nUse `POST /admin/login` or `POST /admin/signup` to obtain tokens.\nSet `access_token` as `Authorization: Bearer <token>`.\n\n## Variables\n- `admin_url`: Base URL of the Admin API (e.g. http://localhost:8080)\n- `gateway_url`: Base URL of a Dedicated Gateway (e.g. http://localhost:9000)\n- `project_id`: Your project ID (UUID)\n- `access_token`: JWT access token (set automatically after login/signup)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "admin_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "gateway_url",
			"value": "http://localhost:9000",
			"type": "string"
		},
		{
			"key": "project_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "🩺 Health & Readiness",
			"item": [
				{
					"name": "GET /health (Admin)",
					"request": {
						"url": "{{admin_url}}/health",
						"method": "GET",
						"description": "Admin API liveness probe."
					}
				},
				{
					"name": "GET /ready (Admin)",
					"request": {
						"url": "{{admin_url}}/ready",
						"method": "GET",
						"description": "Admin API readiness probe."
					}
				},
				{
					"name": "GET /health (Gateway)",
					"request": {
						"url": "{{gateway_url}}/health",
						"method": "GET",
						"description": "Gateway liveness probe."
					}
				},
				{
					"name": "GET /ready (Gateway)",
					"request": {
						"url": "{{gateway_url}}/ready",
						"method": "GET",
						"description": "Gateway readiness probe."
					}
				}
			]
		},
		{
			"name": "🔐 Authentication (Public)",
			"item": [
				{
					"name": "POST /admin/login",
					"request": {
						"url": "{{admin_url}}/admin/login",
						"method": "POST",
						"auth": { "type": "noauth" },
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your-password\"\n}"
						},
						"description": "Login with username and password. Returns access + refresh tokens."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('access_token', json.access_token);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "POST /admin/refresh",
					"request": {
						"url": "{{admin_url}}/admin/refresh",
						"method": "POST",
						"auth": { "type": "noauth" },
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"your-refresh-token\"\n}"
						},
						"description": "Exchange a refresh token for a new access token."
					}
				},
				{
					"name": "POST /admin/logout",
					"request": {
						"url": "{{admin_url}}/admin/logout",
						"method": "POST",
						"auth": { "type": "noauth" },
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"your-refresh-token\"\n}"
						},
						"description": "Revoke a refresh token."
					}
				},
				{
					"name": "POST /admin/register (Bootstrap)",
					"request": {
						"url": "{{admin_url}}/admin/register",
						"method": "POST",
						"auth": { "type": "noauth" },
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your-password\"\n}"
						},
						"description": "Register the first super-admin (bootstrap). Only works when 0 admin users exist."
					}
				},
				{
					"name": "POST /admin/signup (Self-Service Tenant)",
					"request": {
						"url": "{{admin_url}}/admin/signup",
						"method": "POST",
						"auth": { "type": "noauth" },
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"mycompany\",\n  \"password\": \"your-password\",\n  \"company\": \"My Company Inc.\",\n  \"plan\": \"free\"\n}"
						},
						"description": "Self-service tenant onboarding. Creates admin user + project. Returns tokens + project_id."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('access_token', json.access_token);",
									"    pm.collectionVariables.set('project_id', json.project_id);",
									"}"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "📋 Projects",
			"item": [
				{
					"name": "POST /admin/v1/projects",
					"request": {
						"url": "{{admin_url}}/admin/v1/projects",
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"My Project\",\n  \"slug\": \"my-project\",\n  \"description\": \"My first project\",\n  \"plan\": \"free\"\n}"
						},
						"description": "Create a new project."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('project_id', json.project.id);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "GET /admin/v1/projects",
					"request": {
						"url": "{{admin_url}}/admin/v1/projects",
						"method": "GET",
						"description": "List all projects for the authenticated admin."
					}
				},
				{
					"name": "PUT /admin/v1/projects/:projectId",
					"request": {
						"url": "{{admin_url}}/admin/v1/projects/{{project_id}}",
						"method": "PUT",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Updated Project\",\n  \"description\": \"Updated description\"\n}"
						},
						"description": "Update a project."
					}
				},
				{
					"name": "DELETE /admin/v1/projects/:projectId",
					"request": {
						"url": "{{admin_url}}/admin/v1/projects/{{project_id}}",
						"method": "DELETE",
						"description": "Delete a project (Owner role required)."
					}
				}
			]
		},
		{
			"name": "🔄 Sync & Reload",
			"item": [
				{
					"name": "POST /admin/v1/reload",
					"request": {
						"url": "{{admin_url}}/admin/v1/reload",
						"method": "POST",
						"description": "Trigger a hot-reload of routes/upstreams/policies on ALL active gateway nodes."
