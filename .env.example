# PostgreSQL
POSTGRES_DSN=postgres://coreguard_app:password@postgres:5432/elitegate_db?sslmode=disable

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# Gateway
GATEWAY_PORT=8080
ADMIN_PORT=9090
GRPC_GATEWAY_PORT=:50051
ROUTE_RELOAD_INTERVAL=10s
PROJECT_ID=00000000-0000-0000-0000-000000000000

# JWT
JWT_SECRET=supersecretjwtkey_32byteslongkey!

# Environment
APP_ENV=development

# OAuth & Frontend
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:9090/admin/google/callback
OAUTH_STATE_SECRET=
FRONTEND_URL=http://localhost:5173

# Mail, Password Reset & Email Verification Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Elite Gateway
SMTP_TLS_MODE=starttls
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
RATE_LIMIT_AUTH_RESEND_VERIFICATION_RPM=3
GATEWAY_PUBLIC_HOST=gateway.example.com

# Dedicated Gateway AWS Automation
DEDICATED_GATEWAY_AWS_AUTOMATION_ENABLED=false
AWS_REGION=ap-south-1
ALB_HTTPS_LISTENER_ARN=
AWS_VPC_ID=
AWS_EC2_INSTANCE_ID=
DEDICATED_GATEWAY_BASE_DOMAIN=elitegateway.site
DEDICATED_GATEWAY_RULE_PRIORITY_MIN=1000
DEDICATED_GATEWAY_RULE_PRIORITY_MAX=40000
